---
// Doubles as a heads up that new web techniques are used here on purpose. They're layered on top of
// a working baseline (progressive enhancement), so a browser without support may just look plainer.
const message = "This website is an experimental space and very much a work in progress. It also uses some brand new web techniques, so things may occasionally look or behave oddly in some browsers. Thought I'd mention this just in case anyone was wondering. 🙂";
---
<aside>
  <p>{message}</p>
</aside>

<style>
  /* Wrapped in `@layer components`: Astro's scoped styles are otherwise unlayered, and unlayered
     CSS beats every layer. The wrapper keeps the cascade order from src/styles/index.css true. */
  @layer components {
    /* Component tokens (see the tiers in src/styles/tokens.css): these amber values belong to this
       banner alone, so they're declared here rather than in `:root`, then used below. Custom
       properties inherit, so the <p> inside picks up `--message-text` from the <aside>. */
    aside {
      --message-bg: light-dark(oklch(0.98 0.027 95), oklch(0.26 0.026 96));
      --message-border: light-dark(oklch(0.94 0.076 92), oklch(0.43 0.054 92));
      --message-text: light-dark(oklch(0.47 0.098 102), oklch(0.88 0.066 96));

      background-color: var(--message-bg);
      border: var(--border-thin) solid var(--message-border);
      padding: 1em;
      border-radius: var(--radius);
    }

    p {
      color: var(--message-text);
    }
  }
</style>
