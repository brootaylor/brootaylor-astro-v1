---
const message = "This website is an experimental space and very much a work in progress. Thought I'd mention this just in case anyone was wondering. 🙂";
---
<aside>
  <p>{message}</p>
</aside>

<style>
  aside {
    background-color: hsl(48, 100%, 95%);
    border: 1px solid hsl(45, 100%, 85%);
    padding: 1em;
    border-radius: 4px;
  }

  p {
    margin: 0;
    color: hsl(54, 100%, 20%);
  }
</style>
