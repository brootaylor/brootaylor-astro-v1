---
// Doubles as a heads up that new web techniques are used here on purpose. They're layered on top of
// a working baseline (progressive enhancement), so a browser without support may just look plainer.
const message = "This website is an experimental space and very much a work in progress. It also uses some brand new web techniques, so things may occasionally look or behave oddly in some browsers. Thought I'd mention this just in case anyone was wondering. 🙂";
---
<aside>
  <p>{message}</p>
</aside>

<style>
  /* Wrapped in `@layer components`: Astro's scoped styles are otherwise unlayered, and unlayered
     CSS beats every layer. The wrapper keeps the cascade order from src/styles/index.css true. */
  @layer components {
    /* Scoped rather than global tokens — these amber values are specific to this banner */
    aside {
      background-color: light-dark(oklch(0.98 0.027 95), oklch(0.26 0.026 96));
      border: 1px solid light-dark(oklch(0.94 0.076 92), oklch(0.43 0.054 92));
      padding: 1em;
      border-radius: 0.25rem;
    }

    p {
      color: light-dark(oklch(0.47 0.098 102), oklch(0.88 0.066 96));
    }
  }
</style>
