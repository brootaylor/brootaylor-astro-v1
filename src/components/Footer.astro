<footer class="flow">
  <hr>
  <p>© {new Date().getFullYear()} Bruce Taylor. All rights reserved.</p>
  {/* `#start` is the id on <html> in BaseLayout. The arrow is decorative, so it's hidden from
      screen readers, which read just "Back to top". */}
  <p><a href="#start">Back to top <span aria-hidden="true">&uarr;</span></a></p>
</footer>

<style>
  /* Wrapped in `@layer components`: Astro's scoped styles are otherwise unlayered, and unlayered
     CSS beats every layer. The wrapper keeps the cascade order from src/styles/index.css true. */
  @layer components {
    p {
      font-size: var(--fluid-type--1);
    }
  }
</style>
