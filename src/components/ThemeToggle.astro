---
// Theme control. Writing `data-theme` to <html> overrides the `color-scheme` declared in main.css,
// which is what every `light-dark()` token keys off — so nothing else needs to know this exists.
// No stored choice means no attribute, and the OS preference applies with no JS involved at all.
const options = [
  { value: 'system', label: 'System' },
  { value: 'light', label: 'Light' },
  { value: 'dark', label: 'Dark' },
];
---

{/* Hidden until the script below reveals it, so a no-JS visitor isn't shown a control that can't work */}
<fieldset class="theme-toggle" hidden>
  <legend class="visually-hidden">Choose a colour theme</legend>
  <ul role="list">
    {options.map(({ value, label }) => (
      <li>
        <input type="radio" name="theme" id={`theme-${value}`} value={value} checked={value === 'system'} />
        <label for={`theme-${value}`}>{label}</label>
      </li>
    ))}
  </ul>
</fieldset>

<style>
  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  /* `[role="list"]` in main.css already strips the margin, padding and marker */
  ul {
    display: flex;
    gap: 0.25em;
  }

  /* Hidden visually but still focusable and still announced — the label is the visible control */
  input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  label {
    display: block;
    padding: 0.15em 0.6em;
    border: 1px solid var(--color-hr);
    border-radius: 4px;
    font-size: var(--fluid-type--1);
    cursor: pointer;
  }

  input:checked + label {
    background-color: var(--color-body);
    border-color: var(--color-body);
    color: var(--color-bg);
  }

  /* The input carries focus but is invisible, so the outline has to be drawn on the label */
  input:focus-visible + label {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }
</style>

<script>
  // The key used in localStorage to store the user's theme preference
  const storageKey = 'theme';
  // Select the theme toggle fieldset, which contains the radio buttons for theme selection
  const toggle = document.querySelector('.theme-toggle');

  // If the toggle exists, we can assume scripting is available and proceed to set up the theme toggle functionality
  if (toggle instanceof HTMLFieldSetElement) {
    // Now we know scripting is available...
    toggle.hidden = false; // Reveal the theme toggle control

    // Retrieve the stored theme preference from localStorage
    const stored = localStorage.getItem(storageKey);

    // If a stored preference exists and is either 'light' or 'dark', we set the corresponding radio button to checked
    if (stored === 'light' || stored === 'dark') {
      // Set the checked state of the radio buttons based on the stored preference
      for (const radio of toggle.querySelectorAll('input[name="theme"]')) {
        // If the radio button is an input element, we check if its value matches the stored preference and set it to checked accordingly
        if (radio instanceof HTMLInputElement) radio.checked = radio.value === stored;
      }
    }

    // Add an event listener to the toggle fieldset to handle changes in the selected theme
    toggle.addEventListener('change', (event) => {
      // Ensure the event target is an input element before proceeding
      if (!(event.target instanceof HTMLInputElement)) return;

      // If the selected value is 'system', we remove the `data-theme` attribute from the <html> element, allowing the OS preference to take effect. Otherwise, we set the `data-theme` attribute to the selected value and store it in localStorage for future visits.
      if (event.target.value === 'system') {
        // Removing the attribute hands control back to `prefers-color-scheme`
        delete document.documentElement.dataset.theme;
        localStorage.removeItem(storageKey);
      } else {
        // Setting the attribute overrides `prefers-color-scheme` and applies the selected theme
        document.documentElement.dataset.theme = event.target.value;
        localStorage.setItem(storageKey, event.target.value);
      }
    });
  }
</script>
