---
// Theme control. Writing `data-theme` to <html> overrides the `color-scheme` declared in src/styles/tokens.css,
// which is what every `light-dark()` token keys off — so nothing else needs to know this exists.
// No stored choice means no attribute, and the OS preference applies with no JS involved at all.
const options = [
  { value: 'system', label: 'System' },
  { value: 'light', label: 'Light' },
  { value: 'dark', label: 'Dark' },
];
---

{/* Hidden until the script below reveals it, so a no-JS visitor isn't shown a control that can't work */}
<fieldset class="theme-toggle" hidden>
  <legend class="visually-hidden">Choose a colour theme</legend>
  <ul role="list">
    {options.map(({ value, label }) => (
      <li>
        <input type="radio" name="theme" id={`theme-${value}`} value={value} checked={value === 'system'} />
        <label for={`theme-${value}`}>{label}</label>
      </li>
    ))}
  </ul>
</fieldset>

<style>
  /* Wrapped in `@layer components`: Astro's scoped styles are otherwise unlayered, and unlayered
     CSS beats every layer. The wrapper keeps the cascade order from src/styles/index.css true. */
  @layer components {
    fieldset {
      margin: 0;
      padding: 0;
      border: 0;
    }

    /* `[role="list"]` in src/styles/reset.css already strips the margin, padding and marker */
    ul {
      display: flex;
      gap: 0.25em;
    }

    /* Hidden visually but still focusable and still announced — the label is the visible control */
    input {
      position: absolute;
      width: 1px;
      height: 1px;
      opacity: 0;
    }

    label {
      display: block;
      padding: 0.15em 0.6em;
      border: 1px solid var(--color-hr);
      border-radius: 0.25rem;
      font-size: var(--fluid-type--1);
      cursor: pointer;
    }

    input:checked + label {
      background-color: var(--color-body);
      border-color: var(--color-body);
      color: var(--color-bg);
    }

    /* The input carries focus but is invisible, so the outline has to be drawn on the label */
    input:focus-visible + label {
      outline: 2px solid var(--color-link);
      outline-offset: 2px;
    }
  }
</style>

<script>
  // Shared helper: cross-fades the change where the browser supports it and motion is allowed
  import { withViewTransition } from '../scripts/view-transition';

  // The localStorage key for the visitor's choice. The inline script in BaseLayout.astro's <head>
  // reads the same key to apply it before first paint, so keep the two in step.
  const storageKey = 'theme';
  const toggle = document.querySelector('.theme-toggle');

  // The `instanceof` check narrows the type, and skips everything if the markup is ever missing.
  if (toggle instanceof HTMLFieldSetElement) {
    // This script running is what proves JavaScript is available, so the control can be shown.
    toggle.hidden = false;

    // The inline script in BaseLayout.astro's <head> has already applied any stored choice to <html>
    // as `data-theme`, so read it from there rather than from localStorage again. No attribute
    // means 'system'.
    const current = document.documentElement.dataset.theme ?? 'system';

    // Tick the radio that matches the current theme.
    for (const radio of toggle.querySelectorAll('input[name="theme"]')) {
      if (radio instanceof HTMLInputElement) radio.checked = radio.value === current;
    }

    // One listener on the fieldset catches a change on any of its radios.
    toggle.addEventListener('change', (event) => {
      if (!(event.target instanceof HTMLInputElement)) return;

      const value = event.target.value;

      // 'system' removes the attribute and the stored choice, handing control back to the OS.
      // Light or Dark sets the attribute and stores it for the next visit.
      const applyTheme = () => {
        if (value === 'system') {
          // Removing the attribute hands control back to `prefers-color-scheme`
          delete document.documentElement.dataset.theme;
          localStorage.removeItem(storageKey);
        } else {
          // Setting the attribute overrides `prefers-color-scheme` and applies the selected theme
          document.documentElement.dataset.theme = value;
          localStorage.setItem(storageKey, value);
        }
      };

      // Cross-fade between the old and new colours where possible; otherwise the theme switches instantly.
      withViewTransition(applyTheme);
    });
  }
</script>
