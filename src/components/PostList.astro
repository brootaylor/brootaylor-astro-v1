---
// A list of posts, each a link with its date beneath. Used by the posts listing and by the offline
// page's "Posts you've read", so the two can't drift. It renders the posts it's given, in the
// order given; which posts, and whether drafts are out, is the caller's business (normally
// getPublishedPosts() in src/utils/posts.ts).
import type { CollectionEntry } from 'astro:content';

// Date helpers, so this list and the post pages format dates identically.
import { formatDate, toDateTime } from '../utils/date';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---

<ul class="flow">
  {posts.map((post) => (
    <li>
      {/* Trailing slash to match the directory static output writes, as the feed does. */}
      <a href={`/posts/${post.id}/`}>{post.data.title}</a>
      <time datetime={toDateTime(post.data.date)}>{formatDate(post.data.date)}</time>
    </li>
  ))}
</ul>

<style>
  /* Wrapped in `@layer components`: Astro's scoped styles are otherwise unlayered, and unlayered
     CSS beats every layer. The wrapper keeps the cascade order from src/styles/index.css true. */
  @layer components {
    /* The date sits under its link rather than beside it, so long titles don't push it out of view */
    time {
      display: block;
      font-size: var(--fluid-type--1);
    }
  }
</style>
