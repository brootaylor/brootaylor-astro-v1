---
import Link from "./Link.astro";
---

<nav>
  <ul role="list">
    <li>
      <Link href="/">Home</Link>
    </li>
    <li>
      <Link href="/about">About</Link>
    </li>
    <li>
      <Link href="/posts">Posts</Link>
    </li>
  </ul>
</nav>

<style>
  /* Spacing below now lives on `.nav-wrapper` in Header.astro, which centre-aligns this against the theme toggle */

  /* No disclosure menu: the links wrap onto a second row rather than overflowing,
     so navigation never depends on JavaScript at any width */
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1em;
  }
</style>
