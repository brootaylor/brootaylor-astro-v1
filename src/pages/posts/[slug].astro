---
// One page per published post, at /posts/<id>/.
import { render } from 'astro:content';
import PostsLayout from '../../layouts/PostsLayout.astro';

// The same published-posts helper the listing and the feed use. Drafts get no page built at all,
// so a draft can't be listed, syndicated, indexed or reached by guessing its URL — one rule
// everywhere rather than three surfaces each remembering to filter. Preview drafts with `npm run dev`.
import { getPublishedPosts } from '../../utils/posts';

// `post.id` is already URL-ready: the glob loader strips the file extension and slugifies the
// filename (or uses a `slug` from frontmatter). The listing and the feed link with it too.
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<PostsLayout frontmatter={post.data}>
  <Content />
</PostsLayout>
