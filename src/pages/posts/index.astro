---
// The posts listing: every published post, newest first, each with its date.
import BaseLayout from '../../layouts/BaseLayout.astro';

// The list markup and its styles, shared with the offline page.
import PostList from '../../components/PostList.astro';

// Drafts filtered out of builds (kept under `npm run dev`) and sorted newest first. Shared with
// the post pages and the RSS feed, so the three can't drift.
import { getPublishedPosts } from '../../utils/posts';

const sortedPosts = await getPublishedPosts();

const title = 'Posts';
---

<BaseLayout title={title}>
  <p>Here are some posts.</p>
  <PostList posts={sortedPosts} />
</BaseLayout>
