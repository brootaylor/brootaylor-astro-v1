---
// This is the main page for the blog posts. It fetches all the published blog entries from the `posts` collection, checks their draft status, sorts them by date, and displays them in a list with links to their individual pages.
import BaseLayout from "../../layouts/BaseLayout.astro";

// Import the `getCollection` function from `astro:content` to fetch the blog posts collection.
import { getCollection } from 'astro:content';

// Date helpers, so the listing and the post pages format dates identically.
import { formatDate, toDateTime } from '../../utils/date';

// Get all blog entries that are not drafts
const publishedBlogEntries = await getCollection('posts', ({ data }) => {
  return data.draft !== true;
});

// Sort the blog entries by date in descending order (newest first)
const sortedPosts = publishedBlogEntries.sort((a, b) => {
  return b.data.date.valueOf() - a.data.date.valueOf();
});

//
const title = "Posts";
---

<BaseLayout title={title}>
  <p>Here are some posts.</p>
  <ul class="flow">
    {sortedPosts.map((post) => (
      <li>
        <a href={`/posts/${post.id}`}>{post.data.title}</a>
        <time datetime={toDateTime(post.data.date)}>{formatDate(post.data.date)}</time>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  /* The date sits under its link rather than beside it, so long titles don't push it out of view */
  time {
    display: block;
    font-size: var(--fluid-type--1);
  }
</style>
