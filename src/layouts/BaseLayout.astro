---
import Link from "../components/Link.astro";

import "../styles/main.css";

const { title = "Broo's Website" } = Astro.props;
---

<!doctype html>
<html lang="en-gb">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav>
        <Link href="/">Home</Link>
        <Link href="/about">About</Link>
      </nav>
    </header>
    <main>
      <article>
        <slot />
      </article>
    </main>
    <footer>
      <hr>
      <p>© {new Date().getFullYear()} Bruce Taylor.</p>
    </footer>
  </body>
</html>
