---
import Message from "../components/Message.astro";
import Navigation from "../components/Navigation.astro";

import "../styles/main.css";

const { title = "Broo's Website" } = Astro.props;
---

<!doctype html>
<html lang="en-gb">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
  </head>
  <body>
    <header>
      <Message />
      <Navigation />
    </header>
    <main>
      <article>
        <slot />
      </article>
    </main>
    <footer>
      <hr>
      <p>© Bruce Taylor {new Date().getFullYear()}. All rights reserved.</p>
    </footer>
  </body>
</html>
