---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

import "../styles/main.css";

const { title = "Broo's Website" } = Astro.props;
---

<!doctype html>
<html lang="en-gb">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <main>
      <article class="flow">
        <slot />
      </article>
    </main>
    <Footer />
  </body>
</html>
