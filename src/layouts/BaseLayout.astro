---
import SkipLink from '../components/SkipLink.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import { siteName, siteDescription, siteLang, siteLocale, ownerFirstName, ownerLastName } from '../site';
import { toDateTime } from '../utils/date';

// The one place global CSS is pulled in. index.css imports the partials (reset, tokens, base,
// utilities, transitions) — see the comments there for how it all fits. The layer order itself
// is declared in the <head> below.
import '../styles/index.css';

// The Open Graph type (https://ogp.me/#types): how a page is described when it's shared. Each
// type has its own extra properties, so the type and the data it needs travel together in one
// `og` prop, and the <head> below renders one block per type. "website" is the default and has
// no extra properties. "profile" (the homepage and the About page, which are about a person) takes
// its name from src/site.ts, so it needs no data either. "article" (every post, via PostsLayout)
// carries its dates.
//
// To support a new type: add its shape to this union, then a block for its properties in the
// <head>, after the "article" one. ogp.me lists each type's properties; all are optional there.
type OpenGraph =
  | { type: 'website' }
  | { type: 'profile' }
  | { type: 'article'; publishedTime: Date; modifiedTime?: Date };

interface Props {
  title?: string;
  description?: string;
  og?: OpenGraph;
  noindex?: boolean;
  article?: boolean;
}

// `noindex` keeps a page out of search results; only the offline page uses it. Every other page
// gets an explicit "index, follow".
//
// `article` decides the page's document structure, and is separate from `og` on purpose:
// one is how a page is described when shared, the other is what its markup means. Set it on
// any page whose content is a self-contained piece that would make sense on its own (a post
// does; a listing or a status page doesn't). Off by default, so a page is a plain page unless it
// says otherwise. PostsLayout sets it for every post; any other page can opt in the same way.
//
// To make a page an article, add `article` to its <BaseLayout> (shorthand for `article={true}`,
// like `noindex`). Anything given `slot="meta"` goes in the article's <header>, under the <h1>;
// leave it out and the header holds just the <h1>. src/pages/index.astro and src/pages/about.astro
// are working examples:
//
//   <BaseLayout title={title} article>
//     <p slot="meta">Optional: shown in the article's header, under the title.</p>
//     <p>The body of the page…</p>
//   </BaseLayout>
//
// renders as:
//
//   <main>
//     <article class="flow">
//       <header class="flow"><h1>…</h1> <p>Optional: …</p></header>
//       <p>The body of the page…</p>
//     </article>
//   </main>
//
// Without `article`, the same page renders as <main class="flow"><h1>…</h1> <p>…</p></main>, and
// anything in `slot="meta"` is dropped.
const {
  title = siteName,
  description = siteDescription,
  og = { type: 'website' },
  noindex = false,
  article = false,
} = Astro.props;

// Pages read "<page> — <site>" so a browser tab or a shared link carries both. Every page passes
// its own title today; a page that passes none falls back to the site name, and this guard stops
// it rendering twice.
const pageTitle = title === siteName ? siteName : `${title} — ${siteName}`;

// Absolute URL of the page being rendered, for the canonical link and og:url. Both must be
// absolute, and `Astro.site` is what makes that possible.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

// An article's `article:author` is a URL, not a name: it points at a "profile" page, which is
// what the About page is. If that page ever moves, update this.
const authorUrl = new URL('/about/', Astro.site);
---

<!doctype html>
<html id="start" lang={siteLang} dir="ltr">
  <!--
      "Here is the world. Beautiful and terrible things will happen. Don't be afraid."

      - Frederick Buechner
  -->
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>{pageTitle}</title>
    <meta name="description" content={description}>
    {/* Every page states its robots directive outright. "index, follow" is what a crawler assumes
        when the tag is absent, so on an indexed page it changes nothing; it's there to make the
        intent explicit. A `noindex` page (only the offline page) is kept out of search results. */}
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow'}>

    {/* The cascade layer order for the whole site: later layers beat earlier ones, regardless of
        specificity. It has to be an inline <style> ahead of the stylesheet, not a line in
        src/styles/index.css. Layers rank by where they're first seen, and the build's CSS
        minifier merges and reorders the bundled styles (components ended up first, which put
        them below the reset), discarding the ordering statement in the process. An inline style
        ahead of the bundle can't be reordered. Dev doesn't minify, so it looked fine locally and
        was wrong in production. Add new layers here, and see index.css for what each one is for. */}
    <style is:inline>
      @layer reset, tokens, base, components, utilities, transitions;
    </style>
    {/* Runs before the render-blocking stylesheet so a stored choice never flashes the wrong scheme.
        IIFE-wrapped because `is:inline` scripts share the global scope. It can't import anything, so the
        'theme' storage key is written out here and again in ThemeToggle.astro: keep the two in step. */}
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        }
      })();
    </script>

    {/* Names one URL as authoritative, so a page reached via a deploy preview, a trailing-slash
        variant or a query string doesn't get indexed as a separate copy. */}
    <link rel="canonical" href={canonicalUrl}>
    {/* Feed autodiscovery — how a reader finds /rss.xml from any page on the site. */}
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml">

    {/* Open Graph — how the page renders when pasted into a chat app or social post.
        No og:image yet: nothing in public/ is suitable, so shares fall back to a text-only
        card. Adding one image here (after og:url) would upgrade every page at once. */}
    <meta property="og:type" content={og.type}>
    <meta property="og:site_name" content={siteName}>
    <meta property="og:title" content={pageTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:locale" content={siteLocale}>
    {/* The `profile` type's own properties (https://ogp.me/#type_profile), all optional there.
        Only the name is given: the spec's `username` and `gender` are left out. */}
    {og.type === 'profile' && (
      <>
        <meta property="profile:first_name" content={ownerFirstName}>
        <meta property="profile:last_name" content={ownerLastName}>
      </>
    )}
    {/* The `article` type's own properties (https://ogp.me/#type_article). The times use the same
        ISO 8601 form as the post's <time datetime>. `section` and `tag` are left out: posts have
        no frontmatter for them. */}
    {og.type === 'article' && (
      <>
        <meta property="article:published_time" content={toDateTime(og.publishedTime)}>
        {og.modifiedTime && <meta property="article:modified_time" content={toDateTime(og.modifiedTime)}>}
        <meta property="article:author" content={authorUrl}>
      </>
    )}

    {/* `summary` rather than `summary_large_image`, which would reserve space for an image
        that isn't being supplied. Revisit alongside og:image. */}
    <meta name="twitter:card" content="summary">

    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" href="/favicon.ico">
    {/* Astro adds the bundled stylesheet's <link> itself, after everything above, just before
        </head>. Its position isn't configurable; the layer order and theme script above still
        come ahead of it, which is all they need. */}
  </head>
  <body>
    {/* First in <body> so it's the first thing a keyboard user reaches; it jumps to <main id="main">
        below. See SkipLink.astro. */}
    <SkipLink />
    <Header />
    {/* The <h1> is rendered here, from `title`, so page and post bodies start at <h2>. Which
        wrapper it sits in depends on the `article` prop (see the frontmatter above). */}
    {article ? (
      <main id="main">
        {/* An article: a self-contained piece inside <main>. Its title, and anything passed in
            the `meta` slot (a post's dates, say), go in the article's own <header>, the element
            for an article's introductory content. That <header> is not the site header: it
            belongs to the article, so it isn't a banner landmark. `.flow` on the article spaces
            the header and the body; `.flow` on the header spaces the title and the meta. */}
        <article class="flow">
          <header class="flow">
            <h1>{title}</h1>
            <slot name="meta" />
          </header>
          <slot />
        </article>
      </main>
    ) : (
      /* A plain page: the content is the page itself, so it sits directly in <main>, with no
         extra wrapper. Anything passed in the `meta` slot is ignored here. */
      <main id="main" class="flow">
        <h1>{title}</h1>
        <slot />
      </main>
    )}
    <Footer />
    {/* The site-wide browser script. Astro bundles it into an external file; see src/scripts/main.ts. */}
    <script>
      import '../scripts/main';
    </script>
    {/* Registers the service worker (src/service-worker/sw.js, built to /sw.js). It's inline rather
        than in main.ts because it's plumbing, not page behaviour, and needs nothing else to
        load first. Rendered in production builds only: in dev a worker would serve cached pages
        and hide edits. Registers after `load` so the worker's downloads don't compete with the
        page's own. */}
    {import.meta.env.PROD && (
      <script is:inline>
        if ('serviceWorker' in navigator) {
          addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js').catch((error) => {
              console.warn('Offline support is unavailable:', error);
            });
          });
        }
      </script>
    )}
  </body>
</html>
