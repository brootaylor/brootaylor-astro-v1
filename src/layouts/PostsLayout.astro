---
import BaseLayout from "./BaseLayout.astro";

// Date helpers, shared with the posts listing so both format identically.
import { formatDate, toDateTime } from "../utils/date";

const { frontmatter } = Astro.props;
---

{/* BaseLayout renders the <h1>, so the date goes first in the slot to land directly beneath it.
    `description` is optional in the schema — omitting it lets BaseLayout apply the site default. */}
<BaseLayout title={frontmatter.title} description={frontmatter.description} ogType="article">
  {/* The published and updated times are inline siblings inside one <small>, so they read as a
      single line of metadata and need no wrapper paragraph. The "Published:" label is visually
      hidden (the date alone is obvious to a sighted reader, but a screen reader benefits from it),
      and the dot between the two is decorative. "Updated" only appears when the post has an
      `updated` date, formatted by the same helpers as the published one. */}
  <small>
    <span class="visually-hidden">Published: </span><time datetime={toDateTime(frontmatter.date)}>{formatDate(frontmatter.date)}</time>
    {frontmatter.updated && (
      <><i aria-hidden="true">&nbsp;&middot;&nbsp;</i><em><b>Updated: </b></em><time datetime={toDateTime(frontmatter.updated)}>{formatDate(frontmatter.updated)}</time></>
    )}
  </small>
  <slot />
</BaseLayout>

<style>
  /* Wrapped in `@layer components`: Astro's scoped styles are otherwise unlayered, and unlayered
     CSS beats every layer. The wrapper keeps the cascade order from src/styles/index.css true. */
  @layer components {
    /* `<small>` is inline by default. As a direct child of `.flow` it needs to be a block so it
       gets the flow gap beneath the <h1>. The size is set here (rather than left to the browser's
       "smaller") so it matches the listing page's dates. The times inside stay inline. */
    small {
      display: block;
      font-size: var(--fluid-type--1);
    }
  }
</style>
