---
import BaseLayout from "./BaseLayout.astro";

// Date helpers, shared with the posts listing so both format identically.
import { formatDate, toDateTime } from "../utils/date";

const { frontmatter } = Astro.props;
---

{/* BaseLayout renders the <h1>, so the date goes first in the slot to land directly beneath it.
    `description` is optional in the schema — omitting it lets BaseLayout apply the site default. */}
<BaseLayout title={frontmatter.title} description={frontmatter.description} ogType="article">
  <time datetime={toDateTime(frontmatter.date)}>{formatDate(frontmatter.date)}</time>
  <slot />
</BaseLayout>

<style>
  time {
    display: block;
    font-size: var(--fluid-type--1);
  }
</style>
